<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Login</title>

    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <nav id="navbar">
        <div class="navbar-name-logo">
            <span>Mizuta Admin</span>
        </div>

        <p class="info-navbar">Login administrador</p>

        <div class="admin-nav-links">
        <a href="/index" class="nav-admin-button">Volver al inicio</a>
    </div>
    </nav>

    <main class="main-container">
        <section class="admin-section">
            <h1>Login administrador</h1>

            <form id="login-admin-form" class="admin-form" action="/admin/login" method="POST">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" class="admin-input" required>

                <label for="password">Contraseña</label>
                <input type="password" name="password" id="password" class="admin-input" required>

                <button type="button" id="btn-acceso-rapido" class="admin-action-button">
                    Acceso rapido tester
                </button>

                <input type="submit" value="Ingresar" class="admin-action-button">
            </form>

            <% if (typeof error !== "undefined" && error) { %>
                <p class="mensaje-error"><%= error %></p>
            <% } %>
        </section>
    </main>

    <script>
        const btnAccesoRapido = document.getElementById("btn-acceso-rapido");
        const inputEmail = document.getElementById("email");
        const inputPassword = document.getElementById("password");

        btnAccesoRapido.addEventListener("click", () => {
            inputEmail.value = "admin@mizuta.com";
            inputPassword.value = "admin123";
        });
        
    </script>

</body>
</html>