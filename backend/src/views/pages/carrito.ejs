<%- include("../partials/head.ejs") %>
<%- include("../partials/nav.ejs") %> 

    <main>
        <div class="page-container">
            <div class="cart-container">
                <div class="div-header">
                    <button class="btn-seguir-comprando">← Seguir comprando</button>
                    <h1 class="cart-title"><%= about %></h1>
                </div> 
                <div class="info-carrito">
                    <h2 class="info-header">Resumen del carrito</h2>
                    <div id="cart-products">
                        <table class="table">
                            <tr class="table-header">
                                <td class="indicator">Producto</td>
                                <td class="indicator">Cantidad</td>
                                <td class="indicator">Valor</td>
                            </tr>
                        </table>
                        <h2 class="total-amount" id="valor-final">Total</h2>
                        <div class="contenedor-limpiar">
                            <button class="btn-limpiar-carrito">Limpiar Carrito</button>
                        </div>
                        

                    </div>
                </div> 
            </div>
        </div>
    </main>
    <script src="/js/carrito.js"></script>

<%- include("../partials/footer.ejs") %>
